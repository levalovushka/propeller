[Unit]
Description=Propeller share service
Documentation=https://github.com/levalovushka/propeller/blob/main/SERVER.md
After=network-online.target
Wants=network-online.target

[Service]
User=propshare
Group=propshare
# Секрет публикации. Файл root:root 0600, в репозиторий не едет: репозиторий
# публичный. Что там лежит — знает только эта машина и Keychain владельца.
EnvironmentFile=/etc/propeller-share.env
ExecStart=/opt/propeller-share/propeller-share -addr 127.0.0.1:8080 -dir /var/lib/propeller-share
Restart=always
RestartSec=2

# Слушает только петлю: наружу его выводит Caddy, и только по /s/* и /api/*.
# Всё остальное сервису недоступно — писать он умеет ровно в один каталог.
StateDirectory=propeller-share
StateDirectoryMode=0700
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
