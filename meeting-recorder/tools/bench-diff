#!/usr/bin/env python3
"""Compare benchmarks/latest.json to baseline.json (plan-testing-metrics M3).

Exit 0 if every metric.median is within baseline.median + tolerance.
Exit 1 on regression. Exit 2 on usage / IO errors.
"""
from __future__ import annotations

import argparse
import json
import math
import sys
from pathlib import Path


def parse_tolerance(tol: str, baseline: float) -> float:
    """Return absolute allowed delta above baseline.median."""
    tol = tol.strip()
    if tol.endswith("%"):
        # "+15%" or "15%"
        pct = float(tol.replace("+", "").replace("%", "")) / 100.0
        return abs(baseline) * pct
    # absolute, e.g. "+0.03"
    return abs(float(tol.replace("+", "")))


def load(path: Path) -> dict:
    with path.open() as f:
        return json.load(f)


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    root = Path(__file__).resolve().parents[1] / "swift" / "benchmarks"
    ap.add_argument("--baseline", type=Path, default=root / "baseline.json")
    ap.add_argument("--latest", type=Path, default=root / "latest.json")
    ap.add_argument("--write-report", type=Path, default=root / "report.md",
                    help="Human-readable markdown report (MVP R)")
    args = ap.parse_args()

    if not args.baseline.exists():
        print(f"Missing baseline: {args.baseline}", file=sys.stderr)
        print("Hint: run Bench once, then `cp latest.json baseline.json`.", file=sys.stderr)
        return 2
    if not args.latest.exists():
        print(f"Missing latest: {args.latest}", file=sys.stderr)
        print("Hint: `cd swift && swift run -c release Bench`", file=sys.stderr)
        return 2

    base = load(args.baseline)
    latest = load(args.latest)
    b_metrics = base.get("metrics") or {}
    l_metrics = latest.get("metrics") or {}

    rows = []
    failed = False
    for key in sorted(set(b_metrics) | set(l_metrics)):
        b = b_metrics.get(key)
        l = l_metrics.get(key)
        if not b or not l:
            rows.append((key, "—", "—", "—", "skip", "missing side"))
            continue
        b_med = float(b["median"])
        l_med = float(l["median"])
        tol = b.get("tolerance") or l.get("tolerance") or "+15%"
        allow = parse_tolerance(str(tol), b_med)
        delta = l_med - b_med
        # Lower is better for all MVP metrics (RTF, spawn_ms, RSS).
        regress = l_med > b_med + allow + 1e-12
        if math.isnan(l_med) or math.isnan(b_med):
            status, note = "skip", "NaN"
        elif regress:
            status, note = "FAIL", f"beyond {tol} (allow +{allow:g})"
            failed = True
        elif delta < -1e-12:
            status, note = "OK", "improved"
        else:
            status, note = "OK", "within tol"
        pct = (delta / b_med * 100.0) if b_med else 0.0
        rows.append((key, f"{b_med:g}", f"{l_med:g}", f"{delta:+g} ({pct:+.1f}%)", status, note))

    # Console table
    print(f"baseline: {args.baseline}  commit={base.get('commit')}")
    print(f"latest:   {args.latest}  commit={latest.get('commit')}")
    print()
    hdr = f"{'metric':32} {'base':>12} {'latest':>12} {'Δ':>18}  status  note"
    print(hdr)
    print("-" * len(hdr))
    for key, b, l, d, st, note in rows:
        print(f"{key:32} {b:>12} {l:>12} {d:>18}  {st}  {note}")
    print()
    print("VERDICT:", "FAIL — regression beyond tolerance" if failed else "PASS — no regressions")

    # Markdown report (R)
    lines = [
        "# Propeller batch benchmark report",
        "",
        f"- **Baseline commit:** `{base.get('commit')}` · machine `{base.get('machine')}`",
        f"- **Latest commit:** `{latest.get('commit')}` · machine `{latest.get('machine')}`",
        f"- **Fixture:** `{latest.get('fixture')}` · audio `{latest.get('audio_duration_s')}s` · runs `{latest.get('runs')}`",
        f"- **Verdict:** {'FAIL' if failed else 'PASS'}",
        "",
        "## Metrics",
        "",
        "| Metric | Baseline | Latest | Δ | Status | Note |",
        "|--------|---------:|-------:|--:|:------:|------|",
    ]
    for key, b, l, d, st, note in rows:
        mark = "FAIL" if st == "FAIL" else ("skip" if st == "skip" else "OK")
        lines.append(f"| `{key}` | {b} | {l} | {d} | {mark} | {note} |")
    lines += [
        "",
        "## Metric key",
        "",
        "| Key | Meaning |",
        "|-----|---------|",
        "| `asr.rtf` | ASR wall-clock / audio duration (lower better) |",
        "| `diarize.rtf` | Diarization wall-clock / audio duration |",
        "| `sidecar.spawn_ms` | gigastt spawn → healthy (ms); 0 if already up |",
        "| `batch.peak_rss_mb` | Peak resident memory during the run (MB) |",
        "| `batch.rss_after_release_mb` | RSS after dropping diarizer (MB) |",
        "",
        "_Generated by `tools/bench-diff`._",
        "",
    ]
    args.write_report.parent.mkdir(parents=True, exist_ok=True)
    args.write_report.write_text("\n".join(lines), encoding="utf-8")
    print(f"Wrote {args.write_report}")

    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
